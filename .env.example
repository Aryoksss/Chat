# Environment Variables — WhatsApp Bot
# Copy ke .env.local untuk production

# =your_value_here
NINE_ROUTER_API_KEY=your_value_here
NINE_ROUTER_BASE_URL=your_value_here
AI_MODEL=your_value_here

# =your_value_here — untuk EDIT gambar (img-gen). Ambil dari DB 9router di VPS:
#   sqlite3 /home/ubuntu/.9router/db/data.sqlite \
#     "select data from providerConnections where provider='cloudflare-ai' and isActive=1"
# atau dari dashboard Cloudflare (API Token + Account ID).
#
# Satu akun:
CF_ACCOUNT_ID=your_value_here
CF_API_KEY=your_value_here
#
# ATAU banyak akun (bot rotasi acak + fallback otomatis kalau satu gagal):
# CF_ACCOUNTS=[{"accountId":"...","apiKey":"..."},{"accountId":"...","apiKey":"..."}]
#
# CF_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# =your_value_here
OWNER_NUMBER=your_value_here
# Nomor/LID bot lain yang harus diabaikan, pisahkan dengan koma
IGNORED_BOT_IDS=
GROUP_JID=your_value_here
                          # Atau isi: 1234567890-123456@g.us

# =your_value_here
PREFIX=your_value_here
LOG_LEVEL=your_value_here
SESSION_DIR=your_value_here

# =your_value_here — TTS suara Hu Tao (Edge-TTS + RVC). Path script bash hutao-voice-note.
# Contoh (VPS): /home/ubuntu/.openclaw/tools/hutao-rvc/hutao-voice-note
# HUTAO_VOICE_SCRIPT=
# VN Hu Tao diterjemahkan ke bahasa Jepang sebelum dibacakan.
HUTAO_VOICE_LANGUAGE=ja
# Balasan VN masuk dan permintaan VN eksplisit selalu memakai Hu Tao.
# Chat teks santai dapat sesekali menjadi VN otomatis dengan pengaturan berikut.
HUTAO_AUTO_VOICE_ENABLED=true
HUTAO_AUTO_VOICE_CHANCE=0.18
HUTAO_AUTO_VOICE_COOLDOWN_MS=600000
HUTAO_AUTO_VOICE_MAX_CHARS=240
