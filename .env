# Environment Variables — WhatsApp Bot
# Copy ke .env.local untuk production

# === 9router AI ===
NINE_ROUTER_API_KEY=your_api_key_here
NINE_ROUTER_BASE_URL=https://api.9router.com/v1
AI_MODEL=gpt-4o-mini

# === WhatsApp ===
OWNER_NUMBER=6281234567890
GROUP_JID=                # Kosongin kalo mau respon di semua grup
                          # Atau isi: 1234567890-123456@g.us

# === Bot ===
PREFIX=.
LOG_LEVEL=info
SESSION_DIR=data/sessions
